@App_HostAddress = http://localhost:5013
@SiteApiKey = dev-site-api-key-0123456789abcdef

### Get ALL tarot cards in a single request (site-to-site API key required)
GET {{App_HostAddress}}/tarot/cards
Accept: application/json
X-API-Key: {{SiteApiKey}}

### Replace the whole deck (bulk sync, site-to-site API key required)
PUT {{App_HostAddress}}/tarot/cards
Content-Type: application/json
Accept: application/json
X-API-Key: {{SiteApiKey}}

[
  {
    "id": "fool",
    "title": "The Fool",
    "arcana": "Major Arcana",
    "image": "cards/fool.jpg",
    "description": "A leap of faith into the unknown.",
    "sortOrder": 0,
    "translations": {
      "en": { "title": "The Fool", "arcana": "Major Arcana", "description": "A leap of faith into the unknown." },
      "fi": { "title": "Narri", "arcana": "Iso arkana", "description": "Uskon hyppy tuntemattomaan." }
    }
  }
]
