      "sortOrder": 0,
      "translations": {
        "en": { "name": "Soldiers of Falroth", "description": "" },
        "fi": { "name": "Falrothin sotilaat", "description": "" }
      }
    }
  ],
  "factions": [
    {
      "id": "dalmen",
      "name": "Dalmen",
